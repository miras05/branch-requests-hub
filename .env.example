# Telegram-бот, который добавляется в группы филиалов (@BotFather)
BOT_TOKEN=
# Куда слать ежедневный дайджест (узнать командой /myid)
ADMIN_CHAT_ID=
# Telegram ID руководителей, которым доступны команды, через запятую
ALLOWED_USERS=

# Groq (llama-3.3-70b-versatile)
GROQ_API_KEY=

# PostgreSQL из docker-compose
DATABASE_URL=postgresql://admin:admin@localhost:5432/ai_system

# Почта (IMAP). Для mail.ru нужен пароль приложения, не пароль от ящика
MAIL_HOST=imap.mail.ru
MAIL_USER=
MAIL_PASS=

# Входящий вебхук Bitrix24 с правами на CRM, Задачи и Пользователей
BITRIX_WEBHOOK_URL=
